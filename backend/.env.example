# Application
APP_NAME='Project Flow'
APP_VERSION='1.0.0'
DEBUG=True
APP_ENV="development"

# Server
HOST="0.0.0.0"
PORT=8000

# PostgreSQL
DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/project_flow_db"

# JWT Auth
SECRET_KEY="your-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"
